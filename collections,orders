from collections import OrderedDict

# 1. Read the number of items
n = int(input())
ordered_dictionary = OrderedDict()

for _ in range(n):
    # 2. Separate item name from price using rsplit
    # This splits once starting from the right side
    line = input().rsplit(' ', 1)
    item_name = line[0]
    net_price = int(line[1])
    
    # 3. Update the running total for that item
    if item_name in ordered_dictionary:
        ordered_dictionary[item_name] += net_price
    else:
        ordered_dictionary[item_name] = net_price

# 4. Print results in insertion order
for item, price in ordered_dictionary.items():
    print(item, price)
