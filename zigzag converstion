class Solution:
    def convert(self, s: str, numRows: int) -> str:
        # If only one row is requested or the string is too short, return it as-is
        if numRows == 1 or numRows >= len(s):
            return s
        
        # Create an array of strings to represent each row
        rows = [''] * numRows
        current_row = 0
        going_down = False
        
        for char in s:
            rows[current_row] += char
            
            # Change direction when we reach the first or last row
            if current_row == 0 or current_row == numRows - 1:
                going_down = not going_down
            
            # Move up or down to the next row
            current_row += 1 if going_down else -1
            
        # Join all row strings together to get the final zigzag pattern
        return "".join(rows)
