from collections import Counter

def generate_logo():
    # Read the input string
    s = input().strip()
    
    # Get the counts of all characters
    counts = Counter(s)
    
    # Sort the dictionary items:
    # 1. By value (count) descending: -x[1]
    # 2. By key (alphabet) ascending: x[0]
    sorted_chars = sorted(counts.items(), key=lambda x: (-x[1], x[0]))
    
    # Print the top three
    for char, count in sorted_chars[:3]:
        print(f"{char} {count}")

if __name__ == "__main__":
    generate_logo()
