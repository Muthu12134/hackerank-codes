def is_vowel(letter):
    # Ensure 'y' is included as a vowel
    return letter in ['a', 'e', 'i', 'o', 'u', 'y']

def score_words(words):
    score = 0
    for word in words:
        num_vowels = 0
        for letter in word:
            if is_vowel(letter):
                num_vowels += 1
        # Even number of vowels scores 2, odd scores 1
        if num_vowels % 2 == 0:
            score += 2
        else:
            score += 1
    return score

# This part handles the input and calls the function
n = int(input())
words = input().split()
print(score_words(words))
