#include <stdio.h>
#include <stdlib.h>

// Function to reverse the array in place
void reverseArray(int *arr, int n) {
    int start = 0;
    int end = n - 1;
    
    // Swap elements from the outside in until pointers meet in the middle
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        
        start++;
        end--;
    }
}

int main() {
    int n;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1) {
        return 1;
    }
    
    // Dynamically allocate memory for n integers
    int *arr = (int *)malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1; // Memory allocation failed
    }
    
    // Read the space-separated integers
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Reverse the array
    reverseArray(arr, n);
    
    // Print the reversed array with space-separated values
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    // Free the dynamically allocated memory
    free(arr);
    
    return 0;
}
