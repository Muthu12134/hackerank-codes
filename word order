from collections import OrderedDict

def count_words():
    n = int(input())
    word_counts = OrderedDict()

    for _ in range(n):
        word = input().strip()
        if word in word_counts:
            word_counts[word] += 1
        else:
            word_counts[word] = 1

    # Output total distinct words
    print(len(word_counts))
    
    # Output occurrences in order of first appearance
    print(*(word_counts.values()))

count_words()
