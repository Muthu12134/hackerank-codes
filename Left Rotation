#include <stdio.h>
#include <stdlib.h>

// Helper function to reverse a section of the array
void reverse(int *arr, int start, int end) {
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
}

// Function to perform left rotation
void rotateLeft(int *arr, int n, int d) {
    // Handle cases where d is greater than or equal to n
    d = d % n;
    if (d == 0) return;

    // 1. Reverse the first d elements
    reverse(arr, 0, d - 1);
    
    // 2. Reverse the remaining elements from d to n-1
    reverse(arr, d, n - 1);
    
    // 3. Reverse the entire array
    reverse(arr, 0, n - 1);
}

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 1;

    int *arr = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    rotateLeft(arr, n, d);

    // Print the rotated array
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");

    free(arr);
    return 0;
}
